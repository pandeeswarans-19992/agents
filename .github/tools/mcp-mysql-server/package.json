{
  "name": "mcp-mysql-server",
  "version": "1.0.0",
  "description": "MCP server that exposes a read-only MySQL query tool for GitHub Copilot agents.",
  "license": "MIT",
  "scripts": {
    "install-deps": "pip install -r requirements.txt",
    "start": "python server.py"
  },
  "mcp": {
    "command": "python",
    "args": ["server.py"],
    "env": {
      "DB_HOST": "${DB_HOST}",
      "DB_PORT": "${DB_PORT}",
      "DB_NAME": "${DB_NAME}",
      "DB_USER": "${DB_USER}",
      "DB_PASSWORD": "${DB_PASSWORD}"
    }
  },
  "keywords": ["mcp", "mysql", "agents", "github-copilot"],
  "engines": {
    "python": ">=3.11"
  }
}
